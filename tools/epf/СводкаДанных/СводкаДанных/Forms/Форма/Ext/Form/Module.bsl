// Сводка данных базы: сколько записей в справочниках и документах.
// Запуск: 1cv8.exe ENTERPRISE /F <база> /Execute СводкаДанных.epf /C "СводкаДанных=<файл результата>"
// Результат пишется в файл (UTF-8), после чего сеанс завершается.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИмяФайла = ИмяФайлаРезультата(ПараметрЗапуска);
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьСводкуНаСервере(ИмяФайла);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ИмяФайлаРезультата(Знач Строка)

	Префикс = "СводкаДанных=";
	Позиция = СтрНайти(Строка, Префикс);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Сред(Строка, Позиция + СтрДлина(Префикс)));

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСводкуНаСервере(Знач ИмяФайла)

	Строки = Новый Массив;
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	Строки.Добавить("Пользователь сеанса: " + ИмяПользователя());

	Попытка
		КоличествоПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей().Количество();
		Строки.Добавить("Пользователей ИБ: " + Формат(КоличествоПользователей, "ЧН=0; ЧГ="));
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Строки.Добавить("Пользователей ИБ: нет прав на чтение (" + ТекстОшибки + ")");
	КонецПопытки;

	ДобавитьКоличестваЗаписей(Строки, Метаданные.Справочники, "Справочник");
	ДобавитьКоличестваЗаписей(Строки, Метаданные.Документы, "Документ");

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Текст.Записать(ИмяФайла, КодировкаТекста.UTF8);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКоличестваЗаписей(Строки, КоллекцияМетаданных, ИмяТипаТаблицы)

	// Один пакетный запрос на порцию таблиц вместо запроса на каждую таблицу.
	РазмерПорции = 100;
	Всего = 0;
	Непустых = 0;
	Части = Новый Массив;
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Части.Добавить("ВЫБРАТЬ """ + ОбъектМетаданных.Имя + """, КОЛИЧЕСТВО(*) ИЗ "
			+ ИмяТипаТаблицы + "." + ОбъектМетаданных.Имя);
		Если Части.Количество() = РазмерПорции Тогда
			ДобавитьНепустые(Строки, Части, ИмяТипаТаблицы, Всего, Непустых);
			Части.Очистить();
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() > 0 Тогда
		ДобавитьНепустые(Строки, Части, ИмяТипаТаблицы, Всего, Непустых);
	КонецЕсли;

	КоличествоТаблиц = КоллекцияМетаданных.Количество();
	ВсегоСтрокой = Формат(Всего, "ЧН=0; ЧГ=");
	Итог = СтрШаблон("ИТОГО %1: непустых %2 из %3, записей %4", ИмяТипаТаблицы,
		Непустых, КоличествоТаблиц, ВсегоСтрокой);
	Строки.Добавить(Итог);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьНепустые(Строки, Части, ИмяТипаТаблицы, Всего, Непустых)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Количество = Выборка[1];
		Если Количество > 0 Тогда
			Непустых = Непустых + 1;
			Всего = Всего + Количество;
			КоличествоСтрокой = Формат(Количество, "ЧН=0; ЧГ=");
			Строка = СтрШаблон("%1.%2 = %3", ИмяТипаТаблицы, Выборка[0], КоличествоСтрокой);
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
